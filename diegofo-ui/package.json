{
  "name": "diegofo-ui",
  "version": "2.0.0",
  "description": "Librería de Web Components accesibles y sin dependencias: botones, formularios, modales, tablas de datos, pestañas y más.",
  "author": "Diego Fernández Ortega",
  "license": "MIT",
  "type": "module",
  "main": "./dist/diegofo-ui.esm.js",
  "module": "./dist/diegofo-ui.esm.js",
  "unpkg": "./dist/diegofo-ui.min.js",
  "exports": {
    ".": {
      "types": "./types/diegofo-ui.d.ts",
      "import": "./dist/diegofo-ui.esm.js"
    },
    "./min": "./dist/diegofo-ui.min.js",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "types",
    "docs/COMPONENTES.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "ui",
    "design-system",
    "accesibilidad",
    "vanilla-js",
    "diegofo"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "docs": "node scripts/docs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dev": "npx --yes serve .. -l 5173",
    "empaquetar": "node -e \"require('fs').mkdirSync('paquete',{recursive:true})\" && npm pack --pack-destination paquete",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.5",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  },
  "types": "./types/diegofo-ui.d.ts",
  "homepage": "https://diegofdzortega.github.io/diegofo-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiegoFdzOrtega/diegofo-ui.git",
    "directory": "diegofo-ui"
  },
  "bugs": {
    "url": "https://github.com/DiegoFdzOrtega/diegofo-ui/issues"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  }
}
